# Fill secrets locally. Never commit .env.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
MODEL_PLANNER=openai:deepseek-chat
MODEL_RESEARCHER=openai:deepseek-chat
MODEL_SYNTHESIZER=openai:deepseek-chat
MODEL_CRITIC=openai:deepseek-chat
MODEL_JUDGE=openai:deepseek-chat
# Only web/hybrid research requires this:
TAVILY_API_KEY=

# BM25 runs without an embedding service. DeepSeek chat credentials alone
# do not provide an embedding model. Dense/hybrid needs a separate compatible API.
RETRIEVAL_MODE=bm25
EMBEDDING_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
RERANKER_MODEL=
RERANKER_CANDIDATES=20
KNOWLEDGE_TRANSPORT=local
KNOWLEDGE_DB_PATH=data/knowledge.db
CHUNK_SIZE=1000
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
MAX_CONTEXT_CHARS=16000
MAX_EVIDENCE=50

# Localhost demo defaults. For sharing: disable anonymous and set distinct keys.
ALLOW_ANONYMOUS=true
API_KEYS={}
# Example syntax only; replace every secret: API_KEYS={"alice":"replace-with-random-secret"}
REQUESTS_PER_MINUTE=60

# Production Compose profile. Generate strong unique values before sharing.
RUNTIME_PROFILE=local
TASK_BACKEND=thread
RATE_LIMIT_BACKEND=memory
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
POSTGRES_PASSWORD=replace-with-a-strong-password
CELERY_QUEUE=research
WORKER_LEASE_SECONDS=600
MAX_RECOVERY_ATTEMPTS=3
EVENT_RETENTION=1000
LOG_FORMAT=text
WORKER_METRICS_PORT=9101
OUTBOX_METRICS_PORT=9102

CHECKPOINT_DB_PATH=data/checkpoints.db
JOB_DB_PATH=data/jobs.db
MAX_WORKERS=2
MAX_PENDING_JOBS=16
MAX_RESEARCH_SUBTASKS=3
MAX_RESEARCHER_MODEL_CALLS=3
MAX_RESEARCHER_TOOL_CALLS=3
MAX_MODEL_CALLS=30
MAX_LLM_CALLS_PER_RUN=22
TASK_TIMEOUT_SECONDS=300
MODEL_TIMEOUT_SECONDS=60
GRAPH_RECURSION_LIMIT=40
STRUCTURED_OUTPUT_ATTEMPTS=2
MAX_RESEARCH_ITERATIONS=2
MAX_OUTPUT_REPAIRS=1
HITL_APPROVAL_ENABLED=false
GUARDRAIL_INPUT_ENABLED=true
GUARDRAIL_OUTPUT_ENABLED=true

# Opt in only when sending prompts/documents to the tracing provider is acceptable.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=academic-research-agent
